{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|\\.well-known/|assets/|icons/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "30 1 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "functions": {
    "api/daily.js": {
      "maxDuration": 60
    }
  }
}
